{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/work/garage",
      "destination": "/#work-garage",
      "permanent": false
    },
    {
      "source": "/work/build",
      "destination": "/#work-build",
      "permanent": false
    },
    {
      "source": "/work/velora",
      "destination": "/#work-velora",
      "permanent": false
    },
    {
      "source": "/work/table",
      "destination": "/#work-table",
      "permanent": false
    },
    {
      "source": "/work/clinic",
      "destination": "/#work-clinic",
      "permanent": false
    },
    {
      "source": "/work/leather",
      "destination": "/#work-leather",
      "permanent": false
    },
    {
      "source": "/work",
      "destination": "/#work",
      "permanent": false
    },
    {
      "source": "/blog/whatsapp-business-api-guide",
      "destination": "/ecommerce-development",
      "permanent": true
    },
    {
      "source": "/website-redesign",
      "destination": "/website-design",
      "permanent": true
    },
    {
      "source": "/landing-page-design",
      "destination": "/website-design",
      "permanent": true
    },
    {
      "source": "/products/(.*)",
      "destination": "/ecommerce-development",
      "permanent": true
    },
    {
      "source": "/products",
      "destination": "/ecommerce-development",
      "permanent": true
    },
    {
      "source": "/blog/(.*)",
      "destination": "/website-design",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/website-design",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(images|videos)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(styles\\.css|script\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
